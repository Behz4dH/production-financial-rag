# Required
GROQ_API_KEY=your_groq_key_here

# LLM / embeddings (defaults shown)
LLM_PROVIDER=groq
PRIMARY_MODEL=llama-3.1-8b-instant
FALLBACK_MODEL=llama-3.3-70b-versatile
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Reranker: "llm" (default) or "cross_encoder"
RERANKER_PROVIDER=llm
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_LLM_MODEL=llama-3.3-70b-versatile
RERANK_SNIPPET_CHARS=500
RERANK_BATCH_SIZE=20

# Vector store / data
VECTOR_STORE=chroma
CHROMA_DIR=data/chroma
DATA_DIR=data/docs

# Retrieval
RETRIEVAL_MODE=hybrid
TOP_K=20
TOP_N=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
REFUSAL_SCORE_THRESHOLD=0.3

# Security / reliability / limits
ENABLE_LLM_GUARD=false
LLM_MAX_RETRIES=3
REQUEST_MAX_RETRIES=3
RETRY_BASE_DELAY=0.5
MAX_CONTEXT_TOKENS=4500
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-rag

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
